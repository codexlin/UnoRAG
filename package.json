{
	"name": "unorag",
	"version": "0.1.0",
	"private": true,
	"license": "Apache-2.0",
	"homepage": "https://github.com/codexlin/UnoRAG#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codexlin/UnoRAG.git"
	},
	"bugs": {
		"url": "https://github.com/codexlin/UnoRAG/issues"
	},
	"engines": {
		"node": ">=22 <23"
	},
	"packageManager": "pnpm@9.7.1",
	"pnpm": {
		"overrides": {
			"esbuild": "0.28.1",
			"hono": "4.12.34",
			"nanoid": "3.3.17"
		}
	},
	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start",
		"test": "node --test tests/*.test.mjs",
		"test:ts-core": "tsx --test --test-concurrency=1 tests/ts-core/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"audit:prod": "pnpm audit --prod --audit-level moderate --registry=https://registry.npmjs.org/",
		"licenses:check": "node scripts/check-production-licenses.mjs",
		"format": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:bootstrap": "node scripts/bootstrap-control-plane.mjs",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"eval:live": "tsx scripts/run-ab-live-e2e.ts",
		"eval:stability": "tsx scripts/run-ab-stability.ts",
		"lifecycle:inspect": "node scripts/inspect-lifecycle.mjs",
		"lifecycle:check": "node scripts/inspect-lifecycle.mjs --fail-on-dead --fail-on-stuck",
		"ask-runs:maintain": "tsx scripts/maintain-ask-runs.ts --dry-run",
		"ask-runs:maintain:apply": "tsx scripts/maintain-ask-runs.ts --execute",
		"tombstones:maintain": "tsx scripts/maintain-tombstones.ts --dry-run",
		"tombstones:maintain:apply": "tsx scripts/maintain-tombstones.ts --execute",
		"conversations:backfill": "node scripts/backfill-conversations.mjs",
		"conversations:backfill:apply": "node scripts/backfill-conversations.mjs --apply",
		"acl:backfill-projections": "node scripts/backfill-acl-projections.mjs",
		"acl:backfill-projections:apply": "node scripts/backfill-acl-projections.mjs --apply",
		"worker:dbos": "tsx src/worker/entry.ts",
		"worker:control": "tsx src/worker/control-entry.ts",
		"worker:enqueue": "tsx src/worker/enqueue.ts",
		"worker:dispatch": "tsx src/worker/dispatch-entry.ts",
		"worker:reconcile": "tsx src/worker/reconcile-entry.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.17",
		"@base-ui/react": "^1.3.0",
		"@dbos-inc/dbos-sdk": "4.24.16",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@langchain/core": "1.1.48",
		"@langchain/langgraph": "1.4.8",
		"@llamaindex/liteparse": "2.10.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/api-logs": "0.221.0",
		"@opentelemetry/context-async-hooks": "2.10.0",
		"@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-logs": "0.221.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@opentelemetry/sdk-trace-base": "2.10.0",
		"@qdrant/js-client-rest": "1.14.1",
		"@tanstack/react-query": "5.101.4",
		"ai": "7.0.42",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"htmlparser2": "10.0.0",
		"jszip": "3.10.1",
		"lucide-react": "^1.7.0",
		"mammoth": "1.11.0",
		"motion": "^12.43.0",
		"next": "16.3.0",
		"next-themes": "^0.4.6",
		"pg": "^8.22.0",
		"pino": "10.1.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "^10.1.0",
		"redis": "5.8.2",
		"remark-gfm": "^4.0.1",
		"server-only": "0.0.1",
		"shiki": "^4.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@langfuse/client": "5.10.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.10",
		"postcss": "8.5.25",
		"shadcn": "^4.2.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
