{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "UnoRAG Pilot Feedback",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "release_revision", "deployment_id", "period", "scenario_results", "decision"],
	"properties": {
		"schema_version": { "const": 1 },
		"release_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
		"deployment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
		"period": {
			"type": "object",
			"additionalProperties": false,
			"required": ["started_at", "finished_at"],
			"properties": {
				"started_at": { "type": "string", "format": "date-time" },
				"finished_at": { "type": "string", "format": "date-time" }
			}
		},
		"participant_counts": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"admins": { "type": "integer", "minimum": 0 },
				"editors": { "type": "integer", "minimum": 0 },
				"viewers": { "type": "integer", "minimum": 0 }
			}
		},
		"scenario_results": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["scenario_id", "result", "evidence_refs"],
				"properties": {
					"scenario_id": { "type": "string", "minLength": 1, "maxLength": 128 },
					"result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
					"evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
					"notes": { "type": "string", "maxLength": 2000 }
				}
			}
		},
		"incident_refs": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
		"known_limitations": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
		"decision": { "enum": ["GO", "CONDITIONAL_GO", "NO_GO"] },
		"decision_owner": { "type": "string", "maxLength": 128 },
		"approved_at": { "type": ["string", "null"], "format": "date-time" }
	}
}
