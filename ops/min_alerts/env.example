# =============================================================================
# MeriKnow minimum alerts (B5) — ops process only
# Copy to ops/min_alerts/.env (gitignored). Not required by apps/api.
# =============================================================================

# Notify channels (at least one required unless --dry-run):
#   1) Generic webhook (Feishu etc. — optional / later)
ALERT_WEBHOOK_URL=

#   2) Resend email (preferred for private webch until Feishu is ready)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Comma-separated recipients
ALERT_EMAIL_TO=
# Optional: override Resend HTTP endpoint (local mock / tests)
# ALERT_RESEND_API_URL=https://api.resend.com/emails

MERIKNOW_HEALTH_URL=http://web:3000/api/rag/health

DOCUMENT_STORAGE_ROOT=/var/lib/meriknow/documents

MERIKNOW_ALERT_DISK_THRESHOLD=85
MERIKNOW_ALERT_HEARTBEAT_MAX_AGE_SEC=120
MERIKNOW_ALERT_STATE_FILE=/var/lib/meriknow-alerts/state.json
MERIKNOW_ALERT_SEVERITY=warning
MERIKNOW_ALERT_NAMESPACE=meriknow

# Optional: dead/stuck SQL + worker heartbeat path when probing a live stack
# DATABASE_URL=
# LIFECYCLE_WORKER_READY_FILE=/tmp/meriknow-lifecycle-ready
