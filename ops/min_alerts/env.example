# =============================================================================
# UnoRAG minimum alerts (B5) — ops process only
# Copy to ops/min_alerts/.env (gitignored). This is an operator-side tool.
# =============================================================================

# Notify channels (at least one required unless --dry-run):
#   1) Generic webhook (Feishu etc. — optional / later)
ALERT_WEBHOOK_URL=

#   2) Resend email (preferred for private webch until Feishu is ready)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Comma-separated recipients
ALERT_EMAIL_TO=
# Optional: override Resend HTTP endpoint (local mock / tests)
# ALERT_RESEND_API_URL=https://api.resend.com/emails

UNORAG_HEALTH_URL=http://web:3000/api/rag/health

DOCUMENT_STORAGE_ROOT=/var/lib/unorag/documents

UNORAG_ALERT_DISK_THRESHOLD=85
UNORAG_ALERT_HEARTBEAT_MAX_AGE_SEC=120
UNORAG_ALERT_STATE_FILE=/var/lib/unorag-alerts/state.json
UNORAG_ALERT_SEVERITY=warning
UNORAG_ALERT_NAMESPACE=unorag

# Optional: dead/stuck SQL + worker heartbeat path when probing a live stack
# DATABASE_URL=
# LIFECYCLE_WORKER_READY_FILE=/tmp/unorag-lifecycle-ready
