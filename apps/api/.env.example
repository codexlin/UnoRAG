APP_NAME=MeriKnow API
APP_ENV=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# stub | live（默认 live；缺密钥或 Qdrant 不可达时硬失败，不降级 stub；stub 仅测试）
ASK_MODE=live

# OpenAI-compatible（DashScope 示例）
# OPENAI_API_KEY=
# 或 DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# 与根目录 docker-compose.yml 中 Qdrant 端口一致
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meriknow_chunks

CHUNK_SIZE=500
CHUNK_OVERLAP=80
# legacy | v2（默认 v2：结构优先切片；md/txt/pdf/docx）
INGEST_PIPELINE=v2
# PDF 扫描/失败页：partial | fail
PDF_SCAN_STRATEGY=partial
OCR_ENABLED=false
VLM_ENABLED=false
# VLM_MODEL=qwen-vl-plus
# 可选工具化 ask（默认短路径 retrieve→generate）
TOOL_ASK=false
RETRIEVE_TOP_K=6
# 最高检索分低于此值则拒答（0=关闭弱相关拒答）；无命中始终拒答
ANSWER_MIN_SCORE=0.4
MAX_RETRIEVE_RETRIES=1

# 可选：dense 检索后调用 DashScope-compatible /reranks（失败自动回退 dense）
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_TOP_K=6

# 多轮短记忆：同 session_id 追问时 rewrite 带上一轮问题
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_MAX_TURNS=6

# Dense + BM25 混合检索（RRF）；失败自动回退 dense
HYBRID_ENABLED=true
BM25_TOP_K=20
RRF_K=60

# 元数据：Postgres 必选（与 docker compose 中 postgres 一致）
# 仅测试可设 METADATA_BACKEND=json；生产/本地开发禁止静默降级
METADATA_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://meriknow:meriknow@localhost:5432/meriknow
# METADATA_PATH=data/metadata.json

# stub 模式下上传/入库：false=返回 503（默认）；true=模拟 ready（仅测试）
STUB_INGEST_SIMULATE=false

# 异步索引：true=落盘后入 Redis/ARQ 队列并返回 202（需 redis + worker）
# false=同请求内同步 ingest（本地无 Redis 时可关）
INGEST_ASYNC=true
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_BYTES=52428800
INGEST_QUEUE_MAX_DEPTH=100
INGEST_MAX_INFLIGHT_PER_LIBRARY=8
INGEST_WORKER_MAX_JOBS=2
INGEST_JOB_TIMEOUT_S=600
# worker: uv run arq app.worker.WorkerSettings
