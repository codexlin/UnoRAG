APP_NAME=MeriKnow API
# Local development only. Private production deployments must set production.
APP_ENV=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Control Plane -> FastAPI RAG Data Plane
# 本地走 /api/rag BFF 时应开启，这样 ask/retrieve 使用 session org/workspace UUID，
# 而不是下面的 DEFAULT_* 回退。私有化生产必须开启。
# Never expose the FastAPI port publicly; only Next.js/workers may access it.
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_SECRET=replace-with-random-32-byte-secret
# 单进程开发可用 memory；production 必须 redis，跨 worker 防重放。
INTERNAL_AUTH_REPLAY_BACKEND=memory

# Must match apps/web bootstrap MERIKNOW_ORGANIZATION_ID / MERIKNOW_WORKSPACE_ID.
# Used when INTERNAL_AUTH_ENABLED=false and for AccessScope.development.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# stub | live（默认 live；缺密钥或 Qdrant 不可达时硬失败，不降级 stub；stub 仅测试）
ASK_MODE=live

# OpenAI-compatible（DashScope 示例）
# OPENAI_API_KEY=
# 或 DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# 与根目录 docker-compose.yml 中 Qdrant 端口一致
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meriknow_chunks

CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNKING_PROFILE=balanced
CHUNK_POLICY_VERSION=v1
SEMANTIC_CHUNKING_ENABLED=false
SEMANTIC_CHUNK_MIN_CHARS=1200
SEMANTIC_CHUNK_BREAK_PERCENTILE=85
# legacy | v2（默认 v2：结构优先切片；md/txt/pdf/docx）
INGEST_PIPELINE=v2
# PDF 扫描/失败页：partial | fail
PDF_SCAN_STRATEGY=partial
OCR_ENABLED=false
VLM_ENABLED=false
# VLM_MODEL=qwen-vl-plus
# MinerU（扫描/复杂 PDF 补充解析；默认关闭，数字 PDF 仍走 PyMuPDF）
# Production 开启时 MINERU_URL 必填，且禁止 MINERU_USE_FAKE。
MINERU_ENABLED=false
# MINERU_URL=http://localhost:8001
# 硬超时（httpx）；软超时放弃本地等待并还 mineru 槽（<=0 关闭软超时）
MINERU_TIMEOUT_S=120
MINERU_SOFT_TIMEOUT_S=60
MINERU_MAX_RETRIES=2
# job 层对 mineru_rate_limited / mineru_soft_timeout 的指数退避（秒）
MINERU_RETRY_BASE_S=30
MINERU_RETRY_MAX_S=300
# 官方 mineru-api / mineru-router 同步解析接口；仅自建兼容网关需要覆盖
MINERU_PARSE_PATH=/file_parse
# auto | pymupdf | mineru
MINERU_MODE=auto
# 仅测试：true 使用 FakeMinerUBackend（勿用于生产）
MINERU_USE_FAKE=false
# Ask generate + ingest embedding/chat 进程内并发（<=0 关闭闸门）
LLM_MAX_INFLIGHT=4
# 可选工具化 ask（默认短路径 retrieve→generate）
TOOL_ASK=false
RETRIEVE_TOP_K=6
# 最高检索分低于此值则拒答（0=关闭弱相关拒答）；无命中始终拒答
ANSWER_MIN_SCORE=0.4
MAX_RETRIEVE_RETRIES=1

# Citation adjudication（裁决）: 宽召回后过滤低相关命中，context/citations 同源
# Legacy CITATION_GATE_* is soft-migrated when these are unset.
CITATION_ADJUDICATE_ENABLED=true
CITATION_ADJUDICATE_ABSOLUTE_FLOOR=0.35
CITATION_ADJUDICATE_RATIO=0.68
CITATION_ADJUDICATE_LEXICAL_THRESHOLD=0.2

# 可选：dense 检索后调用 DashScope-compatible /reranks（失败自动回退 dense）
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_TOP_K=6

# 多轮短记忆：同 session_id 追问时 rewrite 带上一轮问题
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_MAX_TURNS=6

# Dense + BM25 混合检索（RRF）；失败自动回退 dense
HYBRID_ENABLED=true
BM25_TOP_K=20
RRF_K=60

# 元数据：Postgres 必选（与 docker compose 中 postgres 一致）
# 仅测试可设 METADATA_BACKEND=json；生产/本地开发禁止静默降级
METADATA_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://meriknow:meriknow@localhost:5432/meriknow
# METADATA_PATH=data/metadata.json

# stub 模式下上传/入库：false=返回 503（默认）；true=模拟 ready（仅测试）
STUB_INGEST_SIMULATE=false

# 异步索引：true=落盘后入 Redis/ARQ 队列并返回 202（需 redis + worker）
# false=同请求内同步 ingest（本地无 Redis 时可关）
INGEST_ASYNC=true
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_BYTES=52428800
INGEST_QUEUE_MAX_DEPTH=100
INGEST_MAX_INFLIGHT_PER_LIBRARY=8
INGEST_WORKER_MAX_JOBS=2
INGEST_JOB_TIMEOUT_S=600
# worker: uv run arq app.worker.WorkerSettings

# Document Lifecycle V2 PostgreSQL worker (L2).
# Use a login granted only meriknow_worker in production.
# WORKER_DATABASE_URL=postgresql://meriknow_worker_login:secret@postgres:5432/meriknow
# Must be the same shared volume used by Next.js DOCUMENT_STORAGE_ROOT.
# DOCUMENT_STORAGE_ROOT=/var/lib/meriknow/documents
LIFECYCLE_WORKER_POLL_SECONDS=1
LIFECYCLE_WORKER_LEASE_SECONDS=120
LIFECYCLE_WORKER_HEARTBEAT_SECONDS=30
LIFECYCLE_WORKER_VERSION=lifecycle-worker-v1
# worker: uv run python -m app.lifecycle_worker

# L3 authoritative active-generation retrieval gate.
# Production requires true and a login granted only meriknow_rag_read.
ACTIVE_GENERATION_GATE_ENABLED=false
# RAG_READ_DATABASE_URL=postgresql://meriknow_rag_read_login:secret@postgres:5432/meriknow
# Production requires 0 so every retrieval observes an authoritative snapshot.
ACTIVE_GENERATION_CACHE_TTL_SECONDS=0
# Schema migration:
# MIGRATOR_DATABASE_URL=postgresql://... uv run python scripts/apply_rag_migrations.py
