APP_NAME=MeriKnow API
APP_ENV=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# stub | live（live 缺密钥或 Qdrant 不可达时自动降级 stub）
ASK_MODE=stub

# OpenAI-compatible（DashScope 示例）
# OPENAI_API_KEY=
# 或 DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meriknow_chunks

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=6
# 最高检索分低于此值则拒答（0=关闭弱相关拒答）；无命中始终拒答
ANSWER_MIN_SCORE=0.35
MAX_RETRIEVE_RETRIES=1
