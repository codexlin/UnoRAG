# =============================================================================
# MeriKnow API — environment template
# Copy to .env and edit. Do not commit real secrets.
#
# Layers:
#   A) Required for local multi-user / private deploy
#   B) Common tuning (safe defaults exist)
#   C) Optional integrations
#   D) Legacy / test-only (do not enable in product paths)
# =============================================================================

# -----------------------------------------------------------------------------
# A) Required — identity boundary & data plane
# -----------------------------------------------------------------------------
# Local development only. Private production deployments must set production.
APP_ENV=development
APP_NAME=MeriKnow API
API_PREFIX=/v1

# MUST be true whenever Next.js BFF is used with real users.
# false collapses every request to principal_id=development (shared ask archive).
# Must match apps/web MERIKNOW_INTERNAL_SECRET.
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_SECRET=replace-with-random-32-byte-secret
# memory = single-process local; production MUST use redis.
INTERNAL_AUTH_REPLAY_BACKEND=memory

# Postgres (metadata / turns). Prefer same DB as control plane.
METADATA_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://meriknow:meriknow@localhost:5432/meriknow

# Vectors
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meriknow_chunks

# OpenAI-compatible LLM (set ONE key — aliases of the same client)
ASK_MODE=live
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# Shared object volume with Next.js lifecycle worker (preferred storage root).
# DOCUMENT_STORAGE_ROOT=/var/lib/meriknow/documents

# Lifecycle worker (PG SKIP LOCKED). Prefer least-privilege login in prod.
# WORKER_DATABASE_URL=postgresql://meriknow_worker_login:secret@localhost:5432/meriknow
LIFECYCLE_WORKER_POLL_SECONDS=1
LIFECYCLE_WORKER_LEASE_SECONDS=120
LIFECYCLE_WORKER_HEARTBEAT_SECONDS=30
LIFECYCLE_LOCAL_CAPACITY=2
LIFECYCLE_MINERU_CAPACITY=1

# Redis: HMAC replay when INTERNAL_AUTH_REPLAY_BACKEND=redis (not the job SoT).
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# B) Common tuning — defaults are fine for most private deploys
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_RETRIEVE_RETRIES=1
# Ask/retrieval product knobs (retrieve_top_k, answer_min_score, hybrid,
# rerank, citation_adjudicate_*, session_memory_*) are code defaults +
# workspace overrides only — not env. See app/services/ask_defaults.py.
LLM_MAX_INFLIGHT=4
TOOL_ASK=false

BM25_TOP_K=20
RRF_K=60

RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_TOP_K=6

CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNKING_PROFILE=balanced
CHUNK_POLICY_VERSION=v1
SEMANTIC_CHUNKING_ENABLED=false
SEMANTIC_CHUNK_MIN_CHARS=1200
SEMANTIC_CHUNK_BREAK_PERCENTILE=85
INGEST_PIPELINE=v2
PDF_SCAN_STRATEGY=partial
OCR_ENABLED=false
VLM_ENABLED=false

# Active-generation gate (production requires enabled + TTL=0).
ACTIVE_GENERATION_GATE_ENABLED=false
ACTIVE_GENERATION_CACHE_TTL_SECONDS=0
# RAG_READ_DATABASE_URL=postgresql://meriknow_rag_read_login:secret@localhost:5432/meriknow

# -----------------------------------------------------------------------------
# C) Optional — MinerU / OCR supplement
# -----------------------------------------------------------------------------
MINERU_ENABLED=false
# MINERU_URL=http://localhost:8001
MINERU_TIMEOUT_S=120
MINERU_SOFT_TIMEOUT_S=60
MINERU_MAX_RETRIES=2
MINERU_RETRY_BASE_S=30
MINERU_RETRY_MAX_S=300
MINERU_PARSE_PATH=/file_parse
MINERU_MODE=auto
MINERU_USE_FAKE=false

# -----------------------------------------------------------------------------
# D) Dev / test-only helpers (NOT product ingest)
# Product uploads: Next.js → app.jobs → lifecycle_worker.
# FastAPI /v1/ingest* and /v1/documents/*/replace|reindex always return 410.
# -----------------------------------------------------------------------------
# Fallback tenant/workspace ONLY when INTERNAL_AUTH_ENABLED=false.
# Must match apps/web MERIKNOW_ORGANIZATION_ID / MERIKNOW_WORKSPACE_ID.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# Deprecated local dir for FastAPI DocumentStorage helper (tests / old scripts).
# Prefer DOCUMENT_STORAGE_ROOT.
DOCUMENT_STORAGE_DIR=data/documents

MAX_UPLOAD_BYTES=52428800

# Test-only: METADATA_BACKEND=json + STUB_INGEST_SIMULATE. Never in production.
STUB_INGEST_SIMULATE=false
# METADATA_PATH=data/metadata.json
