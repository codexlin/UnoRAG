{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start",
		"test": "node --test tests/*.test.mjs",
		"test:ts-core": "tsx --test tests/ts-core/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:bootstrap": "node scripts/bootstrap-control-plane.mjs",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"lifecycle:inspect": "node scripts/inspect-lifecycle.mjs",
		"lifecycle:check": "node scripts/inspect-lifecycle.mjs --fail-on-dead --fail-on-stuck",
		"conversations:backfill": "node scripts/backfill-conversations.mjs",
		"conversations:backfill:apply": "node scripts/backfill-conversations.mjs --apply",
		"acl:backfill-projections": "node scripts/backfill-acl-projections.mjs",
		"acl:backfill-projections:apply": "node scripts/backfill-acl-projections.mjs --apply",
		"worker:dbos": "tsx src/worker/entry.ts",
		"worker:control": "tsx src/worker/control-entry.ts",
		"worker:enqueue": "tsx src/worker/enqueue.ts",
		"worker:dispatch": "tsx src/worker/dispatch-entry.ts",
		"worker:reconcile": "tsx src/worker/reconcile-entry.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.17",
		"@base-ui/react": "^1.3.0",
		"@dbos-inc/dbos-sdk": "4.24.16",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@langchain/core": "1.1.48",
		"@langchain/langgraph": "1.4.8",
		"@llamaindex/liteparse": "2.10.1",
		"@qdrant/js-client-rest": "1.13.0",
		"@sinclair/typebox": "0.34.41",
		"ai": "7.0.42",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "1.4.29",
		"exact-mirror": "^0.2.2",
		"file-type": "^21.3.0",
		"htmlparser2": "10.0.0",
		"jszip": "3.10.1",
		"lucide-react": "^1.7.0",
		"mammoth": "1.10.0",
		"motion": "^12.43.0",
		"next": "16.2.11",
		"next-themes": "^0.4.6",
		"pg": "^8.22.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "^10.1.0",
		"redis": "5.8.2",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.2.0",
		"shiki": "^4.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.10",
		"openapi-types": "12.1.3",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"typescript": "^5"
	}
}
