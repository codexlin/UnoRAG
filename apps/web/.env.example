# =============================================================================
# UnoRAG Web (control plane) — environment template
# Copy to .env.local and edit. Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# A) Required
# -----------------------------------------------------------------------------
# FastAPI data plane (browser never talks to this URL directly; use /api/rag BFF).
RAG_API_URL=http://localhost:8000

# HMAC to FastAPI. MUST equal apps/api INTERNAL_AUTH_SECRET.
# Keep distinct from UNORAG_SESSION_SECRET.
UNORAG_INTERNAL_SECRET=replace-with-random-internal-secret-32-bytes

# Browser session cookie signing (32+ chars; never equal internal secret).
UNORAG_SESSION_SECRET=replace-with-random-session-secret-32-bytes

# Customer Postgres — Drizzle owns schema "app" only.
DATABASE_URL=postgresql://unorag:unorag@localhost:5432/unorag
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
SESSION_MEMORY_TTL_SECONDS=3600

# TypeScript retrieval migration. off is the production default; shadow runs
# Python and TypeScript retrieval concurrently but still returns Python output.
UNORAG_TS_RETRIEVAL_MODE=off
# python is the rollback-safe default. Set typescript only after migrations,
# conversation backfill, and the final Docker acceptance gate pass.
UNORAG_ASK_RUNTIME=python
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=unorag_chunks
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
AI_SUPPORTS_STRUCTURED_OUTPUTS=true
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
TS_RETRIEVAL_HYBRID_ENABLED=false
TS_RETRIEVAL_RERANK_ENABLED=false

# Shared document objects with lifecycle worker (required in production).
# DOCUMENT_STORAGE_ROOT=/var/lib/unorag/documents

# Private-deployment bootstrap (pnpm db:bootstrap). Stable UUIDs.
UNORAG_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
UNORAG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
UNORAG_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
UNORAG_ORGANIZATION_SLUG=default
UNORAG_ORGANIZATION_NAME=UnoRAG Private Deployment
UNORAG_WORKSPACE_SLUG=default
UNORAG_WORKSPACE_NAME=Default Workspace
UNORAG_ADMIN_SUBJECT=local-admin
UNORAG_ADMIN_EMAIL=admin@example.com
UNORAG_ADMIN_NAME=Local Administrator
UNORAG_ADMIN_PASSWORD=change-this-before-deployment

# -----------------------------------------------------------------------------
# B) Outbox worker (pnpm outbox:run) — library projection to RAG API
# -----------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=2000
OUTBOX_LOCK_TIMEOUT_SECONDS=300
OUTBOX_REQUEST_TIMEOUT_SECONDS=1800
OUTBOX_MAX_ATTEMPTS=8

# -----------------------------------------------------------------------------
# C) Invites (optional email)
# -----------------------------------------------------------------------------
# Public origin for magic links (falls back to request Origin).
# APP_BASE_URL=http://localhost:3000

# none = copy-link only (default for private deploy) | resend
EMAIL_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_FROM=UnoRAG <onboarding@your-domain.com>

# -----------------------------------------------------------------------------
# D) Test-only
# -----------------------------------------------------------------------------
# OUTBOX_TEST_DATABASE_URL=postgresql://unorag:unorag@localhost:5432/unorag
