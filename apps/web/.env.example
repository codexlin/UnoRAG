# =============================================================================
# MeriKnow Web (control plane) — environment template
# Copy to .env.local and edit. Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# A) Required
# -----------------------------------------------------------------------------
# FastAPI data plane (browser never talks to this URL directly; use /api/rag BFF).
RAG_API_URL=http://localhost:8000

# HMAC to FastAPI. MUST equal apps/api INTERNAL_AUTH_SECRET.
# Keep distinct from MERIKNOW_SESSION_SECRET.
MERIKNOW_INTERNAL_SECRET=replace-with-random-internal-secret-32-bytes

# Browser session cookie signing (32+ chars; never equal internal secret).
MERIKNOW_SESSION_SECRET=replace-with-random-session-secret-32-bytes

# Customer Postgres — Drizzle owns schema "app" only.
DATABASE_URL=postgresql://meriknow:meriknow@localhost:5432/meriknow
DATABASE_POOL_MAX=10

# Shared document objects with lifecycle worker (required in production).
# DOCUMENT_STORAGE_ROOT=/var/lib/meriknow/documents

# Private-deployment bootstrap (pnpm db:bootstrap). Stable UUIDs.
MERIKNOW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
MERIKNOW_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
MERIKNOW_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
MERIKNOW_ORGANIZATION_SLUG=default
MERIKNOW_ORGANIZATION_NAME=MeriKnow Private Deployment
MERIKNOW_WORKSPACE_SLUG=default
MERIKNOW_WORKSPACE_NAME=Default Workspace
MERIKNOW_ADMIN_SUBJECT=local-admin
MERIKNOW_ADMIN_EMAIL=admin@example.com
MERIKNOW_ADMIN_NAME=Local Administrator
MERIKNOW_ADMIN_PASSWORD=change-this-before-deployment

# -----------------------------------------------------------------------------
# B) Outbox worker (pnpm outbox:run) — library projection to RAG API
# -----------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=2000
OUTBOX_LOCK_TIMEOUT_SECONDS=300
OUTBOX_REQUEST_TIMEOUT_SECONDS=1800
OUTBOX_MAX_ATTEMPTS=8

# -----------------------------------------------------------------------------
# C) Invites (optional email)
# -----------------------------------------------------------------------------
# Public origin for magic links (falls back to request Origin).
# APP_BASE_URL=http://localhost:3000

# none = copy-link only (default for private deploy) | resend
EMAIL_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_FROM=MeriKnow <onboarding@your-domain.com>

# -----------------------------------------------------------------------------
# D) Test-only
# -----------------------------------------------------------------------------
# OUTBOX_TEST_DATABASE_URL=postgresql://meriknow:meriknow@localhost:5432/meriknow
