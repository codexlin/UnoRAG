# =============================================================================
# UnoRAG Web (local development) — environment template
# Copy to .env.local and edit. Do not commit real secrets.
# For Docker Compose / production deployment, use deploy/config/*.env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# A) Minimal Required (local dev quickstart)
# -----------------------------------------------------------------------------
# Browser session cookie signing (32+ random bytes).
UNORAG_SESSION_SECRET=replace-with-random-session-secret-32-bytes

# Customer Postgres (Drizzle owns schema "app" only), Redis, and Qdrant.
DATABASE_URL=postgresql://unorag:unorag@localhost:5432/unorag
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# OpenAI-compatible model provider (cloud default: Alibaba Cloud DashScope Qwen3.7).
# Private recommendation: Ollama + bge-m3 (LLM_BASE_URL=http://localhost:11434/v1,
# EMBEDDING_MODEL=bge-m3, EMBEDDING_DIM=1024; automatically uses dense-only mode).
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
# Different model gateways require a matching endpoint and dedicated credential.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
JUDGE_API_KEY=
RERANK_API_KEY=
EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# B) Private-Deployment Bootstrap (used only by `pnpm db:bootstrap`)
# -----------------------------------------------------------------------------
UNORAG_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
UNORAG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
UNORAG_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
UNORAG_ORGANIZATION_SLUG=default
UNORAG_ORGANIZATION_NAME=UnoRAG Private Deployment
UNORAG_WORKSPACE_SLUG=default
UNORAG_WORKSPACE_NAME=Default Workspace
UNORAG_ADMIN_SUBJECT=local-admin
UNORAG_ADMIN_EMAIL=admin@example.com
UNORAG_ADMIN_NAME=Local Administrator
UNORAG_ADMIN_PASSWORD=change-this-before-deployment

# -----------------------------------------------------------------------------
# C) Optional Runtime Overrides (code defaults apply when omitted)
# -----------------------------------------------------------------------------
# DATABASE_POOL_MAX=10
# SESSION_MEMORY_TTL_SECONDS=3600
# QDRANT_COLLECTION=unorag_chunks
# TS_RETRIEVAL_HYBRID_ENABLED=true
# Set false to disable reranking across all workspaces regardless of workspace Ask policy.
# TS_RETRIEVAL_RERANK_ALLOWED=true
# Set true to lock Web model/provider settings to server environment variables only.
# MODEL_SETTINGS_LOCKED=false
# RERANK_TIMEOUT_MS=10000
# EMBEDDING_TIMEOUT_MS=15000
# auto = DashScope native dense&sparse for qwen3.7-text-embedding / text-embedding-v3|v4,
# openai_compatible dense-only otherwise (e.g. Ollama bge-m3).
# EMBEDDING_PROTOCOL=auto
# auto = omit `dimensions` for Ollama and fixed-dim models (e.g. bge-m3).
# EMBEDDING_SEND_DIMENSIONS=auto
# RERANK_MODEL=qwen3.7-text-rerank
# AI_SUPPORTS_STRUCTURED_OUTPUTS=true
# DashScope hybrid-thinking models (qwen3.8-flash) default to enable_thinking=false;
# set true only if you explicitly want thinking tokens on DashScope.
# AI_ENABLE_THINKING=false
# Set false only for compatible endpoints that reject stream_options.include_usage.
# AI_INCLUDE_USAGE=true

# Optional Judge override (empty reuses CHAT_MODEL and primary provider).
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_PROVIDER_NAME=
# JUDGE_SUPPORTS_STRUCTURED_OUTPUTS=true
# JUDGE_ENABLE_THINKING=false
# ASK_JUDGE_TIMEOUT_MS=15000
# ASK_JUDGE_MAX_ATTEMPTS=2
# ASK_JUDGE_MAX_OUTPUT_TOKENS=1024

# -----------------------------------------------------------------------------
# D) Optional Storage & Account Emails
# -----------------------------------------------------------------------------
# Shared document objects with the DBOS worker (required in production).
# DOCUMENT_STORAGE_ROOT=/var/lib/unorag/documents
# DOCUMENT_STORAGE_DRIVER=local
# COS_BUCKET=example-1250000000
# COS_REGION=ap-hongkong
# COS_PUBLIC_BASE_URL=https://cos.example.com
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_SECURITY_TOKEN=

# Canonical public origin, required for email login/reset; HTTPS except loopback.
# UNORAG_BASE_URL=http://localhost:3000
# APP_BASE_URL takes precedence when set.
# none = copy-link only (default for private deploy) | resend
# EMAIL_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_FROM=UnoRAG <onboarding@your-domain.com>
