# =============================================================================
# MeriKnow runtime secrets
# Copy to runtime.secret, fill values, chmod 600. Never commit the real file.
# Maps to K8s Secret.
# =============================================================================
#
# Constraints:
#   MERIKNOW_INTERNAL_SECRET  >= 32 random bytes (openssl rand -base64 48)
#   MERIKNOW_SESSION_SECRET   >= 32 random bytes
#   MERIKNOW_INTERNAL_SECRET != MERIKNOW_SESSION_SECRET
#
# Compose maps MERIKNOW_INTERNAL_SECRET → INTERNAL_AUTH_SECRET for FastAPI.
# Do NOT also fill INTERNAL_AUTH_SECRET — one source only.
#
# LLM_API_KEY is the OpenAI-compatible provider credential (DashScope etc.).
# Compose maps it to OPENAI_API_KEY for the current application code.
#
# After ops/postgres/configure-runtime-roles.sql, point worker/read DSNs at
# least-privilege logins; migrator may keep the DDL owner.

# Bundled Postgres bootstrap password (also embedded in the DSNs below)
POSTGRES_PASSWORD=

# One secret source for web HMAC + API internal auth
MERIKNOW_INTERNAL_SECRET=
MERIKNOW_SESSION_SECRET=

# OpenAI-compatible provider credential
LLM_API_KEY=

# Required only when MINERU_PROVIDER=302ai. Never place this in runtime.env.
MINERU_302_API_KEY=

# Control-plane database (Next.js / Drizzle)
DATABASE_URL=

# FastAPI metadata database (prefer postgresql+psycopg://)
API_DATABASE_URL=

# Least-privilege lifecycle worker database
WORKER_DATABASE_URL=

# Least-privilege Retrieve / active-generation database
RAG_READ_DATABASE_URL=

# DDL owner; migration jobs only
MIGRATOR_DATABASE_URL=
