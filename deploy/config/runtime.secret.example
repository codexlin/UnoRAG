# =============================================================================
# UnoRAG runtime secrets
# Copy to runtime.secret, fill values, chmod 600. Never commit the real file.
# Maps to K8s Secret.
# =============================================================================
#
# Constraints:
#   UNORAG_SESSION_SECRET   >= 32 random bytes
#
# LLM_API_KEY is the OpenAI-compatible provider credential (DashScope etc.).
# Compose maps it to OPENAI_API_KEY for the current application code.
#
# Bundled Compose creates fixed login names and grants one role to each.
# Generate URL-safe values, for example: openssl rand -hex 32.

# Bundled Postgres bootstrap password (also embedded in the DSNs below)
POSTGRES_PASSWORD=

# Independent runtime database credentials. Do not reuse POSTGRES_PASSWORD.
UNORAG_WEB_DB_PASSWORD=
UNORAG_WORKER_DB_PASSWORD=
UNORAG_DBOS_DB_PASSWORD=

UNORAG_SESSION_SECRET=

# OpenAI-compatible provider credential
LLM_API_KEY=

# Optional credential for an authenticated self-hosted or 302.AI MinerU endpoint.
MINERU_API_KEY=

# Optional Operations Center notifications. Webhook delivery requires both URL
# and HMAC secret. Email delivery requires EMAIL_PROVIDER=resend in runtime.env.
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_SECRET=
OBSERVABILITY_ALERT_EMAIL_TO=
EMAIL_FROM=
RESEND_API_KEY=

# Optional Ops Stack / external OTLP credentials.
GRAFANA_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_HEADERS=
# "Basic <base64(public-key:secret-key)>"; Collector-only, never injected into app containers.
LANGFUSE_OTLP_AUTHORIZATION=

# Optional DSN overrides for externally managed PostgreSQL. Bundled Compose
# derives DSNs from the five passwords above. Each override must already point
# to a login with the corresponding role from configure-runtime-roles.sql.
# WEB_DATABASE_URL=
# WORKER_DATABASE_URL=
# DBOS_SYSTEM_DATABASE_URL=
# MIGRATOR_DATABASE_URL=
