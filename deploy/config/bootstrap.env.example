# =============================================================================
# MeriKnow bootstrap — one-time control-plane Job only
# Copy to bootstrap.env, fill values, chmod 600. Never commit the real file.
# Maps to K8s Job Secret (delete after first successful bootstrap).
# =============================================================================
#
# Not injected into long-running web/api/worker.
# After bootstrap: change the admin password on first login.

MERIKNOW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
MERIKNOW_ORGANIZATION_SLUG=default
MERIKNOW_ORGANIZATION_NAME=MeriKnow Private Deployment

MERIKNOW_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
MERIKNOW_WORKSPACE_SLUG=default
MERIKNOW_WORKSPACE_NAME=Default Workspace

MERIKNOW_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
MERIKNOW_ADMIN_SUBJECT=local-admin
MERIKNOW_ADMIN_EMAIL=admin@example.com
MERIKNOW_ADMIN_NAME=Local Administrator
# Create-only on bootstrap (re-install will not reset an existing password).
# To rotate later: set a new value and run deploy/compose/scripts/rotate-admin-password.sh
MERIKNOW_ADMIN_PASSWORD=
