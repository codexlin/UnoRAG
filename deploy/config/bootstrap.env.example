# =============================================================================
# UnoRAG bootstrap — one-time control-plane Job only
# Copy to bootstrap.env, fill values, chmod 600. Never commit the real file.
# Maps to K8s Job Secret (delete after first successful bootstrap).
# =============================================================================
#
# Not injected into long-running web/api/worker.
# After bootstrap: change the admin password on first login.

UNORAG_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
UNORAG_ORGANIZATION_SLUG=default
UNORAG_ORGANIZATION_NAME=UnoRAG Private Deployment

UNORAG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
UNORAG_WORKSPACE_SLUG=default
UNORAG_WORKSPACE_NAME=Default Workspace

UNORAG_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
UNORAG_ADMIN_SUBJECT=local-admin
UNORAG_ADMIN_EMAIL=admin@example.com
UNORAG_ADMIN_NAME=Local Administrator
# Create-only on bootstrap (re-install will not reset an existing password).
# To rotate later: set a new value and run deploy/compose/scripts/rotate-admin-password.sh
UNORAG_ADMIN_PASSWORD=
