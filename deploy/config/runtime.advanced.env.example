# =============================================================================
# UnoRAG runtime — advanced non-secret configuration
# Omitted tuning keys use built-in defaults. Add them here to override them.
# Secrets remain in runtime.secret.
# =============================================================================

# Release-managed image pins and bundled infrastructure images
UNORAG_IMAGE_DIGEST=
UNORAG_WEB_IMAGE=unorag-web:local
UNORAG_WEB_MIGRATOR_IMAGE=unorag-web-migrator:local
UNORAG_WEB_OPS_IMAGE=unorag-web-ops:local
UNORAG_DBOS_WORKER_IMAGE=unorag-web-worker:local
UNORAG_IMAGE_PLATFORM=
POSTGRES_IMAGE=postgres:17-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.9.1-alpine
POSTGRES_DB=unorag
POSTGRES_USER=unorag
UNORAG_DBOS_DATABASE=unorag_dbos

# Retrieval, API limits, and uploads
QDRANT_COLLECTION=unorag_chunks
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT=10
AUTH_LOGIN_RATE_LIMIT_PER_IP=60
UNORAG_PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
TS_RETRIEVAL_HYBRID_ENABLED=true
TS_RETRIEVAL_RERANK_ENABLED=false
DOCUMENT_MAX_UPLOAD_BYTES=52428800
COS_PUBLIC_BASE_URL=
AI_SUPPORTS_STRUCTURED_OUTPUTS=true
# Disable only for endpoints rejecting stream_options.include_usage; missing usage stays unknown.
AI_INCLUDE_USAGE=true
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_PROVIDER_NAME=
JUDGE_SUPPORTS_STRUCTURED_OUTPUTS=true
# Selective skips same-document conflict checks for narrowly scoped prose questions.
ASK_CONFLICT_CHECK_MODE=always
# Bounded on-demand VLM reading for persisted PDF figure crops (disabled by default).
VLM_ENABLED=false
VLM_MODEL=
VLM_BASE_URL=
VLM_PROVIDER_NAME=
# Optional retrieval context for long unheaded/OCR chunks; no LLM calls by default.
CONTEXTUAL_RETRIEVAL_ENABLED=false
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# ParserProvider. self_hosted stays inside the deployment boundary; 302ai
# requires EXTERNAL_PARSER_ALLOWED=true and an approved processing policy.
MINERU_PROVIDER=self_hosted
MINERU_302_BASE_URL=https://api.302.ai
EXTERNAL_PARSER_ALLOWED=false
MINERU_SELF_HOSTED_URL=
MINERU_MODE=auto
MINERU_VERSION=2.5
PARSER_MAX_WAIT_MS=900000

# Capacity and durable workflow tuning
LLM_MAX_INFLIGHT=4
LLM_MAX_QUEUE=32
LLM_QUEUE_TIMEOUT_MS=30000
UNORAG_DBOS_LISTEN_QUEUES=ingest-local,ingest-auto,ingest-mineru,lifecycle
UNORAG_DBOS_APPLICATION_VERSION=dev-local
DBOS_UPGRADE_DRAIN_TIMEOUT_SECONDS=1800
DBOS_INGEST_LOCAL_CONCURRENCY=4
DBOS_INGEST_AUTO_CONCURRENCY=2
DBOS_INGEST_MINERU_CONCURRENCY=2
DBOS_LIFECYCLE_CONCURRENCY=2

# Notification transport
EMAIL_PROVIDER=none
# Optional public HTTPS origin for account emails. Defaults to UNORAG_BASE_URL.
APP_BASE_URL=
OBSERVABILITY_ALERT_WEBHOOK_ENABLED=false

# Optional OpenTelemetry / Ops Stack
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.135.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:12.1.1
LOKI_IMAGE=grafana/loki:3.5.3
TEMPO_IMAGE=grafana/tempo:2.8.2
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
ALERTMANAGER_RETENTION_TIME=120h
TEMPO_RETENTION_TIME=72h
LOKI_RETENTION_PERIOD=168h
LANGFUSE_OTLP_ENDPOINT=
