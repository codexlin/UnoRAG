# =============================================================================
# UnoRAG runtime — common non-secret configuration (15 operator-facing keys)
# Copy to runtime.env and edit. Advanced tuning lives in runtime.advanced.env.
# =============================================================================

APP_ENV=production
COMPOSE_PROJECT_NAME=unorag
HTTP_PORT=80
# Optional Compose overlay, resolved relative to deploy/compose.
UNORAG_COMPOSE_OVERLAY=
# Public URL used by health checks and as the fallback account email origin.
UNORAG_BASE_URL=
# Required only with the bundled public HTTPS overlay.
UNORAG_DOMAIN=

# Core data services
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# Document storage: local | cos
DOCUMENT_STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=

# OpenAI-compatible model provider (credential: runtime.secret / LLM_API_KEY).
# Host-local services (Ollama/vLLM/SGLang): use http://host.docker.internal:<port>/v1
# and match EMBEDDING_DIM to EMBEDDING_MODEL. See docs/DEPLOYMENT.md for split endpoints.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
