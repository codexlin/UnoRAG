# =============================================================================
# UnoRAG runtime — common non-secret configuration (15 operator-facing keys)
# Copy to runtime.env and edit. Advanced tuning lives in runtime.advanced.env.
# =============================================================================

APP_ENV=production
COMPOSE_PROJECT_NAME=unorag
HTTP_PORT=80
# Optional Compose overlay, resolved relative to deploy/compose.
UNORAG_COMPOSE_OVERLAY=
# Public URL used by health checks and invite links.
UNORAG_BASE_URL=
# Required only with the bundled public HTTPS overlay.
UNORAG_DOMAIN=

# Core data services
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# Document storage: local | cos
DOCUMENT_STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=

# OpenAI-compatible model provider (credential: runtime.secret / LLM_API_KEY)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
