# =============================================================================
# UnoRAG runtime — non-secret deployment configuration
# Copy to runtime.env and edit. Maps to K8s ConfigMap.
# =============================================================================

APP_ENV=production
UNORAG_IMAGE_DIGEST=

# Compose / edge (interpolation only; not injected into every service)
COMPOSE_PROJECT_NAME=unorag
HTTP_PORT=80
# Public edge URL used by release health checks and pilot smoke.
# Keep empty for local HTTP; set for TLS deployments, e.g. https://kb.example.com.
UNORAG_BASE_URL=

# Image tags (pin before customer handoff)
UNORAG_WEB_IMAGE=unorag-web:local
UNORAG_WEB_MIGRATOR_IMAGE=unorag-web-migrator:local
UNORAG_WEB_OPS_IMAGE=unorag-web-ops:local
UNORAG_DBOS_WORKER_IMAGE=unorag-web-worker:local
# Filled by an official release manifest. Empty means local development images.
UNORAG_IMAGE_PLATFORM=
POSTGRES_IMAGE=postgres:17-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.13.2
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.9.1-alpine

# Bundled Postgres identity (password lives in runtime.secret)
POSTGRES_DB=unorag
POSTGRES_USER=unorag
# Separate DBOS system database; never point this at POSTGRES_DB.
UNORAG_DBOS_DATABASE=unorag_dbos

# -----------------------------------------------------------------------------
# Data plane dependencies
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=unorag_chunks
REDIS_URL=redis://redis:6379
SESSION_MEMORY_TTL_SECONDS=3600
TS_RETRIEVAL_HYBRID_ENABLED=false
TS_RETRIEVAL_RERANK_ENABLED=false
TS_RETRIEVAL_CORPUS_LIMIT=10000

# Document object path is a Compose invariant (/var/lib/unorag/documents on the
# named volume). Do not set DOCUMENT_STORAGE_ROOT here — docker-compose.yml and
# backup/restore hardcode it so mounts cannot diverge via a user-tunable knob.

# Web and worker must use the same limit.
DOCUMENT_MAX_UPLOAD_BYTES=52428800

# -----------------------------------------------------------------------------
# OpenAI-compatible model provider (key in runtime.secret as LLM_API_KEY)
# -----------------------------------------------------------------------------
# DashScope chat and text embeddings use the OpenAI-compatible `compatible-mode` API.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
AI_SUPPORTS_STRUCTURED_OUTPUTS=true
# Optional lower-latency evidence Judge. Empty preserves CHAT_MODEL behavior.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_PROVIDER_NAME=
JUDGE_SUPPORTS_STRUCTURED_OUTPUTS=true
ASK_JUDGE_TIMEOUT_MS=15000
ASK_JUDGE_MAX_ATTEMPTS=2
ASK_JUDGE_MAX_OUTPUT_TOKENS=1024

# Changing embedding model/dimension requires a new generation and reindex.
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# qwen3-rerank uses the separate `compatible-api` endpoint.
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# -----------------------------------------------------------------------------
# Optional parser service — DEPLOY-ADMIN ONLY
# Workspace/Library users never set these. They only choose business intents:
#   parse_preference: auto | quality | local_only
#   scan_handling:    auto | force_ocr | disabled
# Provider URL / API key / timeout / capacity
# must stay in runtime.env / secrets / Helm — not in product UI or library PATCH.
# -----------------------------------------------------------------------------
# Only self_hosted is supported by the current runtime.
MINERU_PROVIDER=self_hosted
# Cloud parsing is fail-closed. Set both values only after customer approval.
MINERU_302_BASE_URL=https://api.302.ai
EXTERNAL_PARSER_ALLOWED=false
# Preferred self-hosted setting; legacy MINERU_URL remains supported.
MINERU_SELF_HOSTED_URL=
MINERU_URL=
MINERU_MODE=auto
MINERU_VERSION=2.5
PARSER_POLL_INTERVAL_MS=250
PARSER_MAX_WAIT_MS=900000
# Retry transient submit/poll/fetch failures on the same idempotent provider task.
PARSER_RETRY_BACKOFF_MS=2000,5000,15000,30000

# -----------------------------------------------------------------------------
# Capacity — advanced deployment tuning (deploy-only)
# -----------------------------------------------------------------------------
DATABASE_POOL_MAX=10
LLM_MAX_INFLIGHT=4
EMBEDDING_BATCH_SIZE=10

UNORAG_DBOS_LISTEN_QUEUES=ingest-local,ingest-auto,ingest-mineru,lifecycle
UNORAG_DBOS_APPLICATION_VERSION=dev-local
DBOS_UPGRADE_DRAIN_TIMEOUT_SECONDS=1800
DBOS_SYSTEM_DATABASE_POOL_SIZE=10
DBOS_INGEST_LOCAL_CONCURRENCY=4
DBOS_INGEST_AUTO_CONCURRENCY=2
DBOS_INGEST_MINERU_CONCURRENCY=2
DBOS_LIFECYCLE_CONCURRENCY=2
DBOS_CONTROL_POLL_MS=5000
ASK_RUN_MAINTENANCE_ENABLED=true
ASK_RUN_MAINTENANCE_INTERVAL_MS=900000
ASK_RUN_STALE_AFTER_MINUTES=30
ASK_RUN_RETENTION_DAYS=30
ASK_RUN_MAINTENANCE_BATCH_SIZE=1000
OBSERVABILITY_CYCLE_ENABLED=true
OBSERVABILITY_CYCLE_INTERVAL_MS=60000

# Optional durable operational notifications. Destinations and credentials live
# in runtime.secret; disabled by default.
EMAIL_PROVIDER=none
OBSERVABILITY_ALERT_WEBHOOK_ENABLED=false
OBSERVABILITY_ALERT_EMAIL_ENABLED=false

# Optional OpenTelemetry / UnoRAG Ops. Core remains independent when disabled.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.135.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:12.1.1
LOKI_IMAGE=grafana/loki:3.5.3
TEMPO_IMAGE=grafana/tempo:2.8.2
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
ALERTMANAGER_RETENTION_TIME=120h
TEMPO_RETENTION_TIME=72h
LOKI_RETENTION_PERIOD=168h

# Optional Langfuse OTLP fan-out. Enable only with the Langfuse Compose overlay.
# Cloud EU example: https://cloud.langfuse.com/api/public/otel
# Self-hosted example: http://langfuse-web:3000/api/public/otel
LANGFUSE_OTLP_ENDPOINT=
