# UnoRAG edge for webch.cn (Aliyun pilot — simulated real user).
# HTTP-01 ACME on :80; HTTPS on :443. Workers and data stores stay unpublished.

{
	email admin@webch.cn
	admin off
}

webch.cn, www.webch.cn {
	encode gzip
	@internalMetrics path /metrics /api/metrics
	respond @internalMetrics 404

	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}
