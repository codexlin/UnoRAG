# UnoRAG private-deployment edge proxy.
# Only the Next.js product edge is exposed; workers and data stores stay internal.

{
	admin off
}

:80 {
	encode gzip
	@internalMetrics path /metrics /api/metrics
	respond @internalMetrics 404

	# Control plane (browser + BFF /api/*).
	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}
