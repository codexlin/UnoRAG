# MeriKnow private deployment — copy to deploy/compose/.env and edit.
# Secrets must never be baked into images or committed.

COMPOSE_PROJECT_NAME=meriknow

# ---------------------------------------------------------------------------
# Image tags (pin before customer handoff; digest locking is a follow-up)
# ---------------------------------------------------------------------------
MERIKNOW_WEB_IMAGE=meriknow-web:local
MERIKNOW_WEB_MIGRATOR_IMAGE=meriknow-web-migrator:local
MERIKNOW_API_IMAGE=meriknow-api:local
POSTGRES_IMAGE=postgres:17-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.13.2
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.9.1-alpine

# ---------------------------------------------------------------------------
# PostgreSQL (customer-managed connection string also supported)
# ---------------------------------------------------------------------------
POSTGRES_DB=meriknow
POSTGRES_USER=meriknow
POSTGRES_PASSWORD=change-me-postgres-password
# Runtime / migrator DSNs (override when using external Postgres)
DATABASE_URL=postgresql://meriknow:change-me-postgres-password@postgres:5432/meriknow
# Migrator may be the same owner during bootstrap; runtime logins should not have DDL.
MIGRATOR_DATABASE_URL=postgresql://meriknow:change-me-postgres-password@postgres:5432/meriknow
# After ops/postgres/configure-runtime-roles.sql, point these at least-privilege logins:
# WORKER_DATABASE_URL=postgresql://meriknow_worker_login:...@postgres:5432/meriknow
# RAG_READ_DATABASE_URL=postgresql://meriknow_rag_read_login:...@postgres:5432/meriknow
WORKER_DATABASE_URL=postgresql://meriknow:change-me-postgres-password@postgres:5432/meriknow
RAG_READ_DATABASE_URL=postgresql://meriknow:change-me-postgres-password@postgres:5432/meriknow
API_DATABASE_URL=postgresql+psycopg://meriknow:change-me-postgres-password@postgres:5432/meriknow

# ---------------------------------------------------------------------------
# Shared document object volume (web + lifecycle worker)
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_ROOT=/var/lib/meriknow/documents

# ---------------------------------------------------------------------------
# Redis (HMAC replay + transition cache only — not the job queue of record)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=meriknow_chunks

# ---------------------------------------------------------------------------
# Control plane secrets (generate unique 32+ byte values)
# ---------------------------------------------------------------------------
MERIKNOW_INTERNAL_SECRET=replace-with-random-internal-secret-32-bytes-min
MERIKNOW_SESSION_SECRET=replace-with-random-session-secret-32-bytes-min
MERIKNOW_ADMIN_PASSWORD=change-this-before-deployment
MERIKNOW_ADMIN_EMAIL=admin@example.com
MERIKNOW_ADMIN_NAME=Local Administrator
MERIKNOW_ADMIN_SUBJECT=local-admin
MERIKNOW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
MERIKNOW_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
MERIKNOW_PRINCIPAL_ID=00000000-0000-4000-8000-000000000003
MERIKNOW_ORGANIZATION_SLUG=default
MERIKNOW_ORGANIZATION_NAME=MeriKnow Private Deployment
MERIKNOW_WORKSPACE_SLUG=default
MERIKNOW_WORKSPACE_NAME=Default Workspace

# ---------------------------------------------------------------------------
# RAG Data Plane — production fail-closed
# ---------------------------------------------------------------------------
APP_ENV=production
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_SECRET=replace-with-random-internal-secret-32-bytes-min
INTERNAL_AUTH_REPLAY_BACKEND=redis
ACTIVE_GENERATION_GATE_ENABLED=true
ACTIVE_GENERATION_CACHE_TTL_SECONDS=0
LEGACY_INGEST_WRITES_ENABLED=false
METADATA_BACKEND=postgres
ASK_MODE=live
DOCUMENT_LIFECYCLE_V2=true

# Customer OpenAI-compatible endpoints (no vendor lock-in in the image)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# Optional MinerU (customer endpoint). Keep disabled unless URL is set.
MINERU_ENABLED=false
# MINERU_URL=http://mineru:8001
MINERU_USE_FAKE=false

# ---------------------------------------------------------------------------
# Edge
# ---------------------------------------------------------------------------
HTTP_PORT=80
# HTTPS_PORT=443
