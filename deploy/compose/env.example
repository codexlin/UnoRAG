# =============================================================================
# DEPRECATED pointer — do not fill a single big compose .env anymore.
# =============================================================================
#
# Split config (source of truth):
#
#   ../config/runtime.env.example     → runtime.env      (non-secret / ConfigMap)
#   ../config/runtime.secret.example  → runtime.secret   (Secret)
#   ../config/bootstrap.env.example   → bootstrap.env    (one-time Job Secret)
#
# Init (copies examples if missing; never overwrites; may migrate legacy .env):
#
#   ./scripts/init-config.sh
#
# Start (from this directory; do not invoke docker compose directly because
# exported host variables take precedence over --env-file):
#
#   source scripts/compose-env.sh
#   mk_compose up -d
#   mk_compose_bootstrap --profile migrate run --rm bootstrap
#
# Real files are gitignored. deploy/compose/.env is legacy and ignored.
