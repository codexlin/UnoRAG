{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "links": [{ "asDropdown": true, "icon": "dashboard", "includeVars": true, "keepTime": true, "tags": ["unorag"], "targetBlank": false, "title": "UnoRAG dashboards", "type": "dashboards" }],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }, "id": 1,
      "targets": [{ "expr": "sum(rate(unorag_ask_with_citations_total{outcome=\"answered\"}[$__rate_interval])) / clamp_min(sum(rate(unorag_ask_completions_total{outcome=\"answered\"}[$__rate_interval])), 0.001)", "legendFormat": "citation coverage", "refId": "A" }],
      "title": "Citation coverage", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }, "id": 2,
      "targets": [{ "expr": "sum(rate(unorag_ask_completions_total{outcome=\"refused\"}[$__rate_interval])) / clamp_min(sum(rate(unorag_ask_completions_total[$__rate_interval])), 0.001)", "legendFormat": "refusal ratio", "refId": "A" }],
      "title": "Refusal ratio", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 }, "id": 3,
      "targets": [{ "expr": "sum(rate(unorag_ask_selected_evidence_total[$__rate_interval])) / clamp_min(sum(rate(unorag_ask_retrieved_evidence_total[$__rate_interval])), 0.001)", "legendFormat": "selected / retrieved", "refId": "A" }],
      "title": "Evidence selection ratio", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }, "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "sum by (query_type, outcome) (rate(unorag_ask_completions_total[$__rate_interval]))", "legendFormat": "{{query_type}} / {{outcome}}", "refId": "A" }],
      "title": "Ask outcomes by query type", "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }, "id": 5,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service_name=\"unorag-web\"} | json | event=\"ask.completed\"", "refId": "A" }],
      "title": "Recent privacy-safe Ask completions", "type": "logs"
    }
  ],
  "refresh": "30s", "schemaVersion": 41, "tags": ["unorag", "rag-quality"],
  "templating": { "list": [] }, "time": { "from": "now-6h", "to": "now" }, "timezone": "browser",
  "title": "UnoRAG RAG Quality", "uid": "unorag-rag-quality", "version": 1
}
